{
  "name": "frodon",
  "productName": "Frodon",
  "version": "0.1.0",
  "description": "A desktop IDE for people who'd rather not switch windows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edouardjamieson/frodon-ide.git"
  },
  "author": "Edouard Jamieson <edouardjamieson99@gmail.com>",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "postinstall": "install-electron && node scripts/fix-spawn-helper.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm run typecheck && electron-vite build",
    "dist": "pnpm run build && electron-builder --mac --publish never",
    "release": "node scripts/release.mjs",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "icons": "electron scripts/build-icons.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.9.1",
    "@codemirror/language": "^6.11.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10",
    "@lezer/highlight": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-unused-imports": "^4",
    "jiti": "^2",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.7",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
