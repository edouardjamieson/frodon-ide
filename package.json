{
  "name": "frodon",
  "version": "0.1.0",
  "description": "Frodon — a terminal-based IDE built with OpenTUI, React, and Bun.",
  "license": "MIT",
  "author": "Edouard Jamieson <edouard@volume7.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edouardjamieson/frodon-ide.git"
  },
  "bugs": {
    "url": "https://github.com/edouardjamieson/frodon-ide/issues"
  },
  "homepage": "https://github.com/edouardjamieson/frodon-ide#readme",
  "keywords": [
    "ide",
    "editor",
    "tui",
    "terminal",
    "cli",
    "opentui",
    "bun"
  ],
  "type": "module",
  "bin": {
    "frodon": "./dist/frodon"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.3.14",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "highlight.js": "^11.12.0",
    "opentui-spinner": "^0.0.7",
    "react": "^19.2.8",
    "refractor": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
