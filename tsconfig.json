{
  // Solution-style: `files` is empty and the two project references below do
  // all the compiling. The `paths` here are therefore not for tsc at all —
  // they exist so that tooling which reads the *root* tsconfig can resolve the
  // aliases. shadcn's CLI is the reason: it maps the aliases in
  // `components.json` through this file, and with no `paths` to find it
  // silently treats `~/components/ui` as a literal directory name and writes a
  // folder called `~` next to `src`. Keep this in sync with the two configs.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.web.json" }
  ]
}
